h1 Aspect Ratio Calculator

p Multiple times per month I ask myself: what aspect ratio is this pixel amount? This is the tool that helps me know better.
p Use the form below to calculate the missing value for a particular aspect ratio. This is useful, for example, when resizing photos or video.

style(type='text/css' media='screen').
  .aspect-example {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    color: var(--color-white);
    background-color: var(--color-light);
  }
  .aspect-example p {
    padding: 0;
  }
  .aspect-equation {
    display: grid;
    grid-template-columns: 1fr 2.5rem 1fr;
    align-items: center;
  }
  .aspect-equals {
    text-align: center;
    font-size: var(--font-size-plus-1);
    color: var(--color-heading);
  }
  .aspect-field {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    grid-gap: .5rem;
    align-items: center;
    padding: .5rem 0;
  }
  .aspect-field:first-child {
    border-bottom: 2px solid var(--color-heading);
  }
  .aspect-field label {
    text-align: right;
    font-size: var(--font-size-minus-1);
  }
  @media screen and (max-width: 767px) {
    .aspect-field {
      grid-template-columns: 1fr;
      grid-gap: 0;
    }
    .aspect-field label {
      text-align: left;
    }
  }

form.tool-form#aspectRatioForm(novalidate)
  .aspect-equation
    .aspect-side
      .aspect-field
        label(for='oldWidth') Original Width:
        input#oldWidth(name='oldWidth' type='number' min='0' step='any' inputmode='decimal' placeholder='Original Width' value='1920')
      .aspect-field
        label(for='oldHeight') Original Height:
        input#oldHeight(name='oldHeight' type='number' min='0' step='any' inputmode='decimal' placeholder='Original Height' value='1080')
    .aspect-equals(aria-hidden='true') =
    .aspect-side
      .aspect-field
        label(for='newWidth') New Width:
        input#newWidth(name='newWidth' type='number' min='0' step='any' inputmode='decimal' placeholder='New Width' value='1280')
      .aspect-field
        label(for='newHeight') New Height:
        input#newHeight(name='newHeight' type='number' min='0' step='any' inputmode='decimal' placeholder='New Height' value='')
  .tool-checkbox
    label
      input#roundResult(name='roundResult' type='checkbox' checked)
      | Round results to the nearest whole number

#alert.tool-alert(role='alert' hidden) Please enter positive numbers for the original width and height, and for either the new width or the new height.
#ratio.tool-results(aria-live='polite' hidden)
  ul
    li
      | The aspect ratio (reduced fraction) is:#{' '}
      strong#aspectRatioFraction
    li
      | The aspect ratio (in decimals) is:#{' '}
      strong#aspectRatioDecimals
    li
      | Pixel count:#{' '}
      strong#pixelCount
      |  pixels
    li
      | Pixel count (rounded):#{' '}
      strong#megapixelCount
      |  megapixels
  #ratioExampleBox.aspect-example(aria-hidden='true'): p

script.
  (() => {
    const EXAMPLE_BOX_HEIGHT_PX = 150
    const DECIMAL_PLACES = 3
    const PIXELS_PER_MEGAPIXEL = 1_000_000

    const oldWidthInput = document.getElementById('oldWidth')
    const oldHeightInput = document.getElementById('oldHeight')
    const newWidthInput = document.getElementById('newWidth')
    const newHeightInput = document.getElementById('newHeight')
    const roundResultInput = document.getElementById('roundResult')
    const alertElement = document.getElementById('alert')
    const ratioElement = document.getElementById('ratio')
    const aspectRatioFractionElement = document.getElementById('aspectRatioFraction')
    const aspectRatioDecimalsElement = document.getElementById('aspectRatioDecimals')
    const pixelCountElement = document.getElementById('pixelCount')
    const megapixelCountElement = document.getElementById('megapixelCount')
    const ratioExampleBox = document.getElementById('ratioExampleBox')

    // Which of the two "new" fields is derived from the other.
    let calculatedDimension = 'height'

    const parsePositiveNumber = (input) => {
      const value = Number.parseFloat(input.value)
      return Number.isFinite(value) && value > 0 ? value : null
    }

    const greatestCommonDivisor = (first, second) => {
      let a = Math.abs(first)
      let b = Math.abs(second)
      while (b !== 0) {
        [a, b] = [b, a % b]
      }
      return a
    }

    const formatReducedFraction = (width, height) => {
      const integerWidth = Math.round(width)
      const integerHeight = Math.round(height)
      const divisor = greatestCommonDivisor(integerWidth, integerHeight) || 1
      return `${integerWidth / divisor}:${integerHeight / divisor}`
    }

    const updateExampleBox = (aspectRatio, fractionLabel) => {
      const availableWidth = ratioElement.clientWidth || EXAMPLE_BOX_HEIGHT_PX * aspectRatio
      let boxHeight = EXAMPLE_BOX_HEIGHT_PX
      let boxWidth = boxHeight * aspectRatio
      if (boxWidth > availableWidth) {
        boxWidth = availableWidth
        boxHeight = boxWidth / aspectRatio
      }
      ratioExampleBox.style.width = `${boxWidth}px`
      ratioExampleBox.style.height = `${boxHeight}px`
      ratioExampleBox.firstElementChild.textContent = fractionLabel
    }

    const showError = () => {
      alertElement.hidden = false
      ratioElement.hidden = true
    }

    const calculate = () => {
      const oldWidth = parsePositiveNumber(oldWidthInput)
      const oldHeight = parsePositiveNumber(oldHeightInput)
      const sourceInput = calculatedDimension === 'height' ? newWidthInput : newHeightInput
      const targetInput = calculatedDimension === 'height' ? newHeightInput : newWidthInput
      const sourceValue = parsePositiveNumber(sourceInput)

      if (oldWidth === null || oldHeight === null || sourceValue === null) {
        targetInput.classList.remove('calculated')
        showError()
        return
      }

      const aspectRatio = oldWidth / oldHeight
      let targetValue = calculatedDimension === 'height' ? sourceValue / aspectRatio : sourceValue * aspectRatio
      if (roundResultInput.checked) targetValue = Math.round(targetValue)

      targetInput.value = targetValue
      targetInput.classList.add('calculated')
      sourceInput.classList.remove('calculated')

      const fractionLabel = formatReducedFraction(oldWidth, oldHeight)
      const pixelCount = oldWidth * oldHeight

      aspectRatioFractionElement.textContent = fractionLabel
      aspectRatioDecimalsElement.textContent = `${aspectRatio.toFixed(DECIMAL_PLACES)}:1`
      pixelCountElement.textContent = Math.round(pixelCount).toLocaleString()
      megapixelCountElement.textContent = (pixelCount / PIXELS_PER_MEGAPIXEL).toLocaleString(undefined, { maximumFractionDigits: 2 })

      alertElement.hidden = true
      ratioElement.hidden = false
      updateExampleBox(aspectRatio, fractionLabel)
    }

    newWidthInput.addEventListener('input', () => {
      calculatedDimension = 'height'
      calculate()
    })
    newHeightInput.addEventListener('input', () => {
      calculatedDimension = 'width'
      calculate()
    })
    oldWidthInput.addEventListener('input', calculate)
    oldHeightInput.addEventListener('input', calculate)
    roundResultInput.addEventListener('change', calculate)
    document.getElementById('aspectRatioForm').addEventListener('submit', (event) => event.preventDefault())

    calculate()
  })()

h2 Explanation / Instructions

ol
  li Enter your values into <code>Original Width</code> and <code>Original Height</code> respectively.
  li Enter one of the values of <code>New Width</code> or <code>New Height</code>.
  li The missing value will be calculated automatically.
  li You can change all values at any time, the calculation updates automatically.

h2 Formula

p You have a photo or video that is 2400 x 3000 pixels (width x height) in resolution, but you'd like to send a file that is only 400px in width to your client for review. To calculate the new height of your photo you can use the following formula (or the calculator above):
pre: code (org. height / org. width) x new width = new height
p With the example numbers above, this would be the calculation:
pre: code (3000 / 2400) x 400 = 500

