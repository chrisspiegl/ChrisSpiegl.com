h1 Time in Milliseconds

p Just a simple millisecond timer for tests and stuff.

style(media="screen" type="text/css").
  #timedate {
    container-type: inline-size;
    width: 100%;
    margin: 4rem auto 8rem;
    padding: 2rem;
    text-align: center;
    color: var(--color-heading);
  }

  #timedate, #timedate div {
    font-family: var(--font-mono) !important;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  #datecomb, #timecomb {
    font-size: 4rem;
    font-size: 9cqi;
  }

div#timedate
  div#datecomb(aria-live='off')
  div#timecomb(aria-live='off')
  noscript JavaScript is needed to display the clock.

script.
  (() => {
    const dateElement = document.getElementById('datecomb')
    const timeElement = document.getElementById('timecomb')
    const dateFormat = { month: 'long', day: 'numeric', year: 'numeric' }

    const pad = (value, length) => String(value).padStart(length, '0')

    const updateClock = () => {
      const now = new Date()
      dateElement.textContent = now.toLocaleDateString('en-US', dateFormat)
      timeElement.textContent = `${pad(now.getHours(), 2)} : ${pad(now.getMinutes(), 2)} : ${pad(now.getSeconds(), 2)} . ${pad(now.getMilliseconds(), 3)}`
      window.requestAnimationFrame(updateClock)
    }

    window.requestAnimationFrame(updateClock)
  })()

