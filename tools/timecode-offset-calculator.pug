---
title: Timecode Offset Calculator
---

include /macros/toolFeedback.pug

h1 Timecode Offset Calculator

p When working with timecode for video and audio synchronizing, sometimes you don't have timecode available on all devices even when using multiple #[a(href='https://crsp.li/TentacleSyncE') Tentacle Sync E] devices. Then you can still sync cameras by showing a timecode slate (#[a(href='https://crsp.li/TentacleApps') Tentacle Timecode App] for iOS) to the camera when you start recording (or at the end) and then later adjust the frame offset.

style(type='text/css' media='screen').
  #timecodeResult {
    text-align: center;
  }
  #resultOffset {
    font-size: var(--font-size-plus-2);
    padding-bottom: 0;
  }

form.tool-form#timecodeForm(novalidate)
  .tool-row
    label(for='fpsFile') File Framerate:
    input#fpsFile(name='fpsFile' type='number' min='1' step='any' inputmode='decimal' placeholder='FPS File' value='24')
  .tool-row
    label(for='tcFile') File Timecode:
    input#tcFile(name='tcFile' type='text' inputmode='numeric' autocomplete='off' placeholder='HH:MM:SS:FF' value='16:13:31:23')
  .tool-row
    label(for='fpsSlate') Slate Framerate:
    input#fpsSlate(name='fpsSlate' type='number' min='1' step='any' inputmode='decimal' placeholder='FPS Slate' value='24')
  .tool-row
    label(for='tcSlate') Slate Timecode:
    input#tcSlate(name='tcSlate' type='text' inputmode='numeric' autocomplete='off' placeholder='HH:MM:SS:FF' value='16:14:14:21')

#alert.tool-alert(role='alert' hidden) Please enter positive framerates and timecodes in the format HH:MM:SS:FF, with frames below the framerate.
#timecodeResult.tool-results(aria-live='polite' hidden)
  | The offset is:
  p#resultOffset
  p#resultOffsetTimecode
p.text-center: small Drop-frame timecode (29.97 / 59.94 DF) is not supported; timecodes are counted as non-drop-frame.

script.
  (() => {
    const SECONDS_PER_MINUTE = 60
    const SECONDS_PER_HOUR = 3600
    const MINUTES_PER_HOUR = 60
    const TIMECODE_PATTERN = /^(\d{1,2}):(\d{2}):(\d{2}):(\d{2,3})$/

    const fpsFileInput = document.getElementById('fpsFile')
    const tcFileInput = document.getElementById('tcFile')
    const fpsSlateInput = document.getElementById('fpsSlate')
    const tcSlateInput = document.getElementById('tcSlate')
    const alertElement = document.getElementById('alert')
    const resultElement = document.getElementById('timecodeResult')
    const resultOffsetElement = document.getElementById('resultOffset')
    const resultOffsetTimecodeElement = document.getElementById('resultOffsetTimecode')

    // Timecode counts whole frames per second, so 23.976 fps uses a 24 frame base.
    const parseTimecodeBase = (input) => {
      const fps = Number.parseFloat(input.value)
      return Number.isFinite(fps) && fps > 0 ? Math.round(fps) : null
    }

    const parseTimecodeToSeconds = (value, timecodeBase) => {
      const match = TIMECODE_PATTERN.exec(value.trim())
      if (!match) return null
      const [hours, minutes, seconds, frames] = match.slice(1).map(Number)
      if (minutes >= MINUTES_PER_HOUR || seconds >= SECONDS_PER_MINUTE || frames >= timecodeBase) return null
      return hours * SECONDS_PER_HOUR + minutes * SECONDS_PER_MINUTE + seconds + frames / timecodeBase
    }

    const formatFramesAsTimecode = (totalFrames, timecodeBase) => {
      const sign = totalFrames < 0 ? '-' : '+'
      const absoluteFrames = Math.abs(totalFrames)
      const frames = absoluteFrames % timecodeBase
      const totalSeconds = Math.floor(absoluteFrames / timecodeBase)
      const hours = Math.floor(totalSeconds / SECONDS_PER_HOUR)
      const minutes = Math.floor((totalSeconds % SECONDS_PER_HOUR) / SECONDS_PER_MINUTE)
      const seconds = totalSeconds % SECONDS_PER_MINUTE
      const pad = (part) => String(part).padStart(2, '0')
      return `${sign}${pad(hours)}:${pad(minutes)}:${pad(seconds)}:${pad(frames)}`
    }

    const calculate = () => {
      const fileBase = parseTimecodeBase(fpsFileInput)
      const slateBase = parseTimecodeBase(fpsSlateInput)
      const fileSeconds = fileBase === null ? null : parseTimecodeToSeconds(tcFileInput.value, fileBase)
      const slateSeconds = slateBase === null ? null : parseTimecodeToSeconds(tcSlateInput.value, slateBase)

      if (fileSeconds === null || slateSeconds === null) {
        alertElement.hidden = false
        resultElement.hidden = true
        return
      }

      const offsetFrames = Math.round((slateSeconds - fileSeconds) * fileBase)
      resultOffsetElement.textContent = `${offsetFrames > 0 ? '+' : ''}${offsetFrames} frames`
      resultOffsetTimecodeElement.textContent = `${formatFramesAsTimecode(offsetFrames, fileBase)} at ${fpsFileInput.value} fps`

      alertElement.hidden = true
      resultElement.hidden = false
    }

    const form = document.getElementById('timecodeForm')
    form.addEventListener('input', calculate)
    form.addEventListener('submit', (event) => event.preventDefault())

    calculate()
  })()

+toolFeedback('Timecode Offset Calculator')
