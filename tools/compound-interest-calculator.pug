---
title: Compound Interest Calculator
---

include /macros/toolFeedback.pug

h1 Compound Interest Calculator

p Calculating how much money you may have with compound interest is a very interesting tool to know how your savings rate will define your future life. Of course, all values on this page are for entertainment purposes only — know your own risk, and be realistic.

form.tool-form#interestForm(novalidate)
  .tool-row
    label(for='investmentInitial') Initial Investment:
    input#investmentInitial(type='number' min='0' step='any' inputmode='decimal' placeholder='Initial Investment' value='1000')
  .tool-row
    label(for='monthlyContribution') Monthly Contribution:
    input#monthlyContribution(type='number' min='0' step='any' inputmode='decimal' placeholder='Monthly Contribution' value='100')
  .tool-row
    label(for='yearlyContribution') Yearly Contribution:
    input#yearlyContribution(type='text' value='1,200.00' readonly tabindex='-1')
  .tool-row
    label(for='years') Years to Grow:
    input#years(type='number' min='1' max='1000' step='1' inputmode='numeric' placeholder='Years to Grow' value='5')
  .tool-row
    label(for='interestRate') Estimated Yearly Interest Rate (%):
    input#interestRate(type='number' min='0' step='any' inputmode='decimal' placeholder='Interest Rate' value='7')

#interestAlert.tool-alert(role='alert' hidden) Please enter non-negative amounts, a whole number of years between 1 and 1000, and a non-negative interest rate.
#interestResults.tool-results(aria-live='polite' hidden)
  p.tool-result-headline
    | In#{' '}
    strong#interestResultYears
    |  years, you will have#{' '}
    strong#interestResultAccumulated
    | .
  ul
    li
      | You will have invested a total of#{' '}
      strong#interestResultInvestedTotal
      |  yourself and earned#{' '}
      strong#interestResultInterestEarned
      |  through interest.
    li
      | Based on the 4% rule, you could then withdraw approx.#{' '}
      strong#interestResultWithdrawal
      |  per year (which equals about#{' '}
      strong#interestResultWithdrawalMonthly
      | ) without running out of money.
  #interestResultTable

h2 Withdrawal Calculator

p This calculator gives you an idea about how your withdrawal could look like.

form.tool-form#withdrawalForm(novalidate)
  .tool-row
    label(for='withdrawalInvestmentInitial') Initial Investment:
    input#withdrawalInvestmentInitial(type='number' min='0' step='any' inputmode='decimal' placeholder='Initial Investment' value='300000')
  .tool-row
    label(for='withdrawalMonthlyPayout') Monthly Payout:
    input#withdrawalMonthlyPayout(type='number' min='0' step='any' inputmode='decimal' placeholder='Monthly Payout' value='1000')
  .tool-row
    label(for='withdrawalYearlyPayout') Yearly Payout:
    input#withdrawalYearlyPayout(type='text' value='12,000.00' readonly tabindex='-1')
  .tool-row
    label(for='withdrawalYears') Years to Payout:
    input#withdrawalYears(type='number' min='1' max='1000' step='1' inputmode='numeric' placeholder='Years to Payout' value='5')
  .tool-row
    label(for='withdrawalInterestRate') Estimated Yearly Interest Rate (%):
    input#withdrawalInterestRate(type='number' min='0' step='any' inputmode='decimal' placeholder='Interest Rate' value='7')

#withdrawalAlert.tool-alert(role='alert' hidden) Please enter non-negative amounts, a whole number of years between 1 and 1000, and a non-negative interest rate.
#withdrawalResults.tool-results(aria-live='polite' hidden)
  p.tool-result-headline
    | After#{' '}
    strong#withdrawalResultYears
    |  years, you will have#{' '}
    strong#withdrawalResultAccumulated
    | .
  ul
    li
      | You will have withdrawn#{' '}
      strong#withdrawalResultWithdrawnTotal
      |  and earned a total of#{' '}
      strong#withdrawalResultInterestEarned
      |  in interest.
    li#withdrawalResultDepleted(hidden)
      | Your money runs out in year#{' '}
      strong#withdrawalResultDepletedYear
      | .
    li#withdrawalResultBad With the current values you are earning less interest per year than you are withdrawing. Your money will run out at some point!
    li#withdrawalResultGood With the current values you are earning more interest per year than you are withdrawing. Your money will last you forever &mdash;&nbsp;stay the course, you are awesome.
  #withdrawalResultTable

script.
  (() => {
    const MONTHS_PER_YEAR = 12
    const PERCENT = 100
    const SAFE_WITHDRAWAL_RATE = 0.04
    const MIN_YEARS = 1
    const MAX_YEARS = 1000

    const currencyFormat = { minimumFractionDigits: 2, maximumFractionDigits: 2 }
    const formatAmount = (value) => value.toLocaleString(undefined, currencyFormat)

    const readNumber = (id) => Number.parseFloat(document.getElementById(id).value)
    const isNonNegative = (value) => Number.isFinite(value) && value >= 0
    const isValidYears = (value) => Number.isInteger(value) && value >= MIN_YEARS && value <= MAX_YEARS

    // Interest is earned on the balance at the start of each year; the cash flow
    // (positive contribution or negative payout) is applied at the end of the year.
    // A schedule stops early once the balance is used up.
    const simulateYears = ({ startingBalance, yearlyInterestRatePercent, years, yearlyCashFlow }) => {
      const interestRate = yearlyInterestRatePercent / PERCENT
      const rows = []
      let balance = startingBalance
      let interestEarnedTotal = 0
      let cashFlowTotal = 0
      let depletedInYear = null

      for (let year = 1; year <= years; year++) {
        const balanceBefore = balance
        const interestEarned = balanceBefore * interestRate
        let cashFlow = yearlyCashFlow
        if (cashFlow < 0 && balanceBefore + interestEarned + cashFlow <= 0) {
          cashFlow = -(balanceBefore + interestEarned)
          depletedInYear = year
        }
        balance = balanceBefore + interestEarned + cashFlow
        interestEarnedTotal += interestEarned
        cashFlowTotal += cashFlow
        rows.push({ year, balanceBefore, cashFlow, interestEarned, balance })
        if (depletedInYear !== null) break
      }

      return { balance, interestEarnedTotal, cashFlowTotal, depletedInYear, rows }
    }

    const renderTable = (container, rows, cashFlowLabel, ariaLabel) => {
      const headerCells = ['Year', 'Before', cashFlowLabel, 'Interest', 'Accumulated']
        .map((label, index) => `<div class="flex-row${index === 0 ? ' first' : ''}" role="columnheader">${label}</div>`)
        .join('')
      const bodyRows = rows.map((row) => `<div class="flex-table row" role="rowgroup">
          <div class="flex-row first" role="cell">${row.year}</div>
          <div class="flex-row" role="cell">${formatAmount(row.balanceBefore)}</div>
          <div class="flex-row" role="cell">${formatAmount(row.cashFlow)}</div>
          <div class="flex-row" role="cell">${formatAmount(row.interestEarned)}</div>
          <div class="flex-row" role="cell">${formatAmount(row.balance)}</div>
        </div>`).join('')
      container.innerHTML = `<div class="tbl-resp" role="table" aria-label="${ariaLabel}">
          <div class="flex-table header" role="rowgroup">${headerCells}</div>
          ${bodyRows}
        </div>`
    }

    const setText = (id, text) => {
      document.getElementById(id).textContent = text
    }

    const toggleResults = (alertId, resultsId, isValid) => {
      document.getElementById(alertId).hidden = isValid
      document.getElementById(resultsId).hidden = !isValid
    }

    const calculateInterest = () => {
      const investmentInitial = readNumber('investmentInitial')
      const monthlyContribution = readNumber('monthlyContribution')
      const years = readNumber('years')
      const interestRate = readNumber('interestRate')
      const yearlyContribution = monthlyContribution * MONTHS_PER_YEAR

      document.getElementById('yearlyContribution').value = Number.isFinite(yearlyContribution) ? formatAmount(yearlyContribution) : ''

      const isValid = isNonNegative(investmentInitial) && isNonNegative(monthlyContribution) && isValidYears(years) && isNonNegative(interestRate)
      toggleResults('interestAlert', 'interestResults', isValid)
      if (!isValid) return

      const { balance, interestEarnedTotal, cashFlowTotal, rows } = simulateYears({
        startingBalance: investmentInitial,
        yearlyInterestRatePercent: interestRate,
        years,
        yearlyCashFlow: yearlyContribution,
      })

      setText('interestResultYears', years)
      setText('interestResultAccumulated', formatAmount(balance))
      setText('interestResultInvestedTotal', formatAmount(investmentInitial + cashFlowTotal))
      setText('interestResultInterestEarned', formatAmount(interestEarnedTotal))
      setText('interestResultWithdrawal', formatAmount(balance * SAFE_WITHDRAWAL_RATE))
      setText('interestResultWithdrawalMonthly', formatAmount(balance * SAFE_WITHDRAWAL_RATE / MONTHS_PER_YEAR))
      renderTable(document.getElementById('interestResultTable'), rows, 'Addition', 'Compound interest by year')
    }

    const calculateWithdrawal = () => {
      const investmentInitial = readNumber('withdrawalInvestmentInitial')
      const monthlyPayout = readNumber('withdrawalMonthlyPayout')
      const years = readNumber('withdrawalYears')
      const interestRate = readNumber('withdrawalInterestRate')
      const yearlyPayout = monthlyPayout * MONTHS_PER_YEAR

      document.getElementById('withdrawalYearlyPayout').value = Number.isFinite(yearlyPayout) ? formatAmount(yearlyPayout) : ''

      const isValid = isNonNegative(investmentInitial) && isNonNegative(monthlyPayout) && isValidYears(years) && isNonNegative(interestRate)
      toggleResults('withdrawalAlert', 'withdrawalResults', isValid)
      if (!isValid) return

      const { balance, interestEarnedTotal, cashFlowTotal, depletedInYear, rows } = simulateYears({
        startingBalance: investmentInitial,
        yearlyInterestRatePercent: interestRate,
        years,
        yearlyCashFlow: -yearlyPayout,
      })
      const yearlyInterestCoversPayout = investmentInitial * interestRate / PERCENT >= yearlyPayout

      setText('withdrawalResultYears', years)
      setText('withdrawalResultAccumulated', formatAmount(balance))
      setText('withdrawalResultWithdrawnTotal', formatAmount(-cashFlowTotal))
      setText('withdrawalResultInterestEarned', formatAmount(interestEarnedTotal))
      document.getElementById('withdrawalResultDepleted').hidden = depletedInYear === null
      if (depletedInYear !== null) setText('withdrawalResultDepletedYear', depletedInYear)
      document.getElementById('withdrawalResultGood').hidden = !yearlyInterestCoversPayout
      document.getElementById('withdrawalResultBad').hidden = yearlyInterestCoversPayout
      renderTable(document.getElementById('withdrawalResultTable'), rows, 'Withdrawal', 'Withdrawals by year')
    }

    const interestForm = document.getElementById('interestForm')
    const withdrawalForm = document.getElementById('withdrawalForm')
    interestForm.addEventListener('input', calculateInterest)
    withdrawalForm.addEventListener('input', calculateWithdrawal)
    interestForm.addEventListener('submit', (event) => event.preventDefault())
    withdrawalForm.addEventListener('submit', (event) => event.preventDefault())

    calculateInterest()
    calculateWithdrawal()
  })()

+toolFeedback('Compound Interest Calculator')
