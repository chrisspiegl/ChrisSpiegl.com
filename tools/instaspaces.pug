---
title: Instagram Paragraph Whitespaces
---

include /macros/toolFeedback.pug

h1 Instagram Paragraph Whitespaces

p.text-center: a(href='https://youtu.be/osFm3XstkDo') Tutorial Video on YouTube

p Making paragraphs work on Instagram is a pain. You can&apos;t have whitespaces at the end of any line, empty lines have to have some kind of character (otherwise they get removed), and it&apos;s really easy to mess these things up.
p This mini tool automatically removes the whitespaces at the end of each line and puts invisible characters into the empty lines. This way you have nice looking paragraphs! #YAY

textarea#txtDescription.tool-textarea(aria-label='Instagram caption' placeholder=`Write Instagram Description here.\nOnce you're done, hit that "Make Whitespaces" button.\nNow you can copy the text and bring it back to Instagram!\nEnjoy ❤`)
#changedStatus.tool-status(role='status' aria-live='polite') Click &quot;Make Whitespaces&quot; to transform.
#characterCount.tool-status 0 / 2200
.side-by-side
  button#btnChange.btn.btn-block(type='button') Make Whitespaces
  button#btnCopy.btn.btn-block(type='button') Copy to Clipboard

script.
  (() => {
    const MAX_CAPTION_LENGTH = 2200
    // U+2800 (Braille Pattern Blank) survives Instagram's whitespace trimming.
    const EMPTY_LINE_PLACEHOLDER = '\u2800\u2800'

    const textarea = document.getElementById('txtDescription')
    const statusElement = document.getElementById('changedStatus')
    const characterCountElement = document.getElementById('characterCount')
    const changeButton = document.getElementById('btnChange')
    const copyButton = document.getElementById('btnCopy')

    let isTransformed = false

    const setStatus = (message, tone) => {
      statusElement.textContent = message
      statusElement.classList.toggle('is-success', tone === 'success')
      statusElement.classList.toggle('is-warning', tone === 'warning')
    }

    const makeWhitespaces = (text) => {
      const outputLines = []
      let previousLineEmpty = false
      for (const rawLine of text.trim().split('\n')) {
        const line = rawLine.trim()
        if (line.length === 0) {
          if (previousLineEmpty) continue
          outputLines.push(EMPTY_LINE_PLACEHOLDER)
          previousLineEmpty = true
        } else {
          outputLines.push(line)
          previousLineEmpty = false
        }
      }
      return outputLines.join('\n').trim()
    }

    const updateCharacterCount = () => {
      const transformedLength = makeWhitespaces(textarea.value).length
      characterCountElement.textContent = `${transformedLength} / ${MAX_CAPTION_LENGTH}`
      characterCountElement.classList.toggle('is-warning', transformedLength > MAX_CAPTION_LENGTH)
    }

    const copyWithSelectionFallback = () => {
      textarea.select()
      const didCopy = document.execCommand('copy')
      textarea.setSelectionRange(textarea.value.length, textarea.value.length)
      return didCopy
    }

    const writeToClipboard = async (text) => {
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text)
          return
        } catch (error) {
          console.warn('Clipboard API failed, trying selection fallback:', error)
        }
      }
      if (!copyWithSelectionFallback()) throw new Error('Copy command was rejected')
    }

    const copyToClipboard = async () => {
      try {
        await writeToClipboard(textarea.value)
        if (isTransformed) {
          setStatus('Copied to clipboard!', 'success')
        } else {
          setStatus('Copied without transformation. Click "Make Whitespaces" first.', 'warning')
        }
      } catch (error) {
        console.error('Instaspaces copy failed:', error)
        setStatus('Could not copy text, please copy it manually.', 'warning')
      }
    }

    textarea.addEventListener('input', () => {
      isTransformed = false
      setStatus('Changed text, click "Make Whitespaces" again to update.', 'warning')
      updateCharacterCount()
    })

    changeButton.addEventListener('click', () => {
      textarea.value = makeWhitespaces(textarea.value)
      isTransformed = true
      setStatus('Updated whitespaces for Instagram.', 'success')
      updateCharacterCount()
    })

    copyButton.addEventListener('click', copyToClipboard)

    updateCharacterCount()
  })()

+toolFeedback('Instaspaces')
