// ChrisSpiegl.com as a Cloudflare Worker with static assets.
//
// Every page and file is served straight from the static assets in _site:
// free, unlimited, and never runs Worker code. The only code is the daily
// cron in worker/index.js, which starts a fresh build through a Workers
// Builds deploy hook so follower counts and the Nomad List location stay
// current. Build and deploy run through utils/ci.js, which also sends the
// PushNotice build report.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chrisspiegl-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // No workers.dev addresses: production is chrisspiegl.com, and branch
  // previews live on *.preview.chrisspiegl.com (a Preview custom domain set
  // up in the dashboard). Deploys apply these two settings every time.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Plain runtime variables for the cron in worker/index.js. Its secrets
  // (DEPLOY_HOOK, PUSHNOTICE_CHAT_SECRET) live in the dashboard under
  // Settings → Variables and Secrets; deploys keep secrets but replace vars
  // with this list.
  "vars": {
    "PUSHNOTICE_CHAT_IDCHAT": "21614670"
  },
  // 03:00 UTC every day (10:00 in Bangkok).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Branch previews (wrangler preview). They serve the same static assets;
  // the cron stays production-only.
  "previews": {
    "observability": {
      "enabled": true
    },
    // Previews don't inherit the top-level vars.
    "vars": {
      "PUSHNOTICE_CHAT_IDCHAT": "21614670"
    }
  }
}
