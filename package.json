{
  "name": "chrisspiegl-com",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "author": {
    "name": "Chris Spiegl",
    "email": "chris@chrisspiegl.com",
    "url": "https://ChrisSpiegl.com/"
  },
  "license": "UNLICENSED",
  "keywords": [],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "pnpm dev",
    "serve": "pnpm dev",
    "dev": "run-s clean eleventy:dev",
    "build": "run-s eleventy:prod",
    "build:clean": "run-s clean eleventy:prod",
    "eleventy:dev": "cross-env NODE_ENV=development eleventy --serve",
    "eleventy:prod": "node utils/unshallow.js && cross-env NODE_ENV=production eleventy",
    "clean": "shx rm -rf _site",
    "cleanup": "shx rm -rf _site .cache",
    "nuke": "pnpm cleanup && pnpm purge --lockfile && pnpm i",
    "check": "linkinator -r -c 10 ./_site; true",
    "cu": "ncu -i --format group",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-plugin-pug": "^1.0.0",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify/utils": "^3.1.7",
    "async-git": "^1.13.3",
    "clean-css": "^5.3.3",
    "cross-env": "^10.1.0",
    "cssesc": "^3.0.0",
    "csvtojson": "^2.0.14",
    "date-fns": "^4.4.0",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "eslint": "^10.15.0",
    "image-size": "^2.1.0",
    "linkinator": "^8.1.0",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "npm-check-updates": "^23.1.1",
    "npm-run-all": "^4.1.5",
    "qrcode": "^1.5.4",
    "sass": "^1.105.1",
    "shx": "^0.4.0"
  }
}
