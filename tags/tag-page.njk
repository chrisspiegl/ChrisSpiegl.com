---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - tagList
  addAllPagesToCollections: true
layout: archive
permalink: /tag/{{ tag }}/
# Internal tags stay out of search (an empty string means "index it").
eleventyComputed:
  noindex: "{{ 'yes' if tag in ['drafts', 'sitemap'] }}"
---

<h1>Posts tagged "{{ tag }}"</h1>

{% set postList = tag %}

