---
title: Links
description: "Field Notes, YouTube, Instagram, and the gear I use: everything I make, in one place."
permalink: /linktree/
layout: page.pug
bare: true
---
//- Replaces linktr.ee/ChrisSpiegl. The follower total comes from _data/followers.js at build time.
-
  const socials = [
    { name: 'Instagram', url: 'https://www.instagram.com/chrisspiegl', icon: 'fa7-brands:instagram' },
    { name: 'YouTube', url: 'https://www.youtube.com/@ChrisSpiegl', icon: 'fa7-brands:youtube' },
    { name: 'Field Notes on Substack', url: 'https://chrisspiegl.substack.com', icon: 'fa7-brands:substack' },
    { name: 'Email', url: `mailto:${meta.authorEmail}`, icon: 'fa7-solid:envelope' },
  ]
  const links = [
    { title: 'Field Notes', sub: 'Be a traveler, not a tourist. Essays on traveling slowly through life.', url: 'https://chrisspiegl.substack.com', icon: 'fa7-brands:substack', platform: 'Substack', primary: true },
    { title: 'My Films', sub: 'Thoughts, tutorials, tech, cameras, and travel.', url: 'https://www.youtube.com/@ChrisSpiegl', icon: 'fa7-brands:youtube', platform: 'YouTube' },
    { title: 'Through the Viewfinder', sub: 'Photos about life, the road less traveled, and the in-between.', url: 'https://www.instagram.com/chrisspiegl', icon: 'fa7-brands:instagram', platform: 'Instagram' },
    { title: 'What\'s in My Bag', sub: 'The gear I actually use and recommend.', url: 'https://www.amazon.com/shop/chrisspiegl', icon: 'fa7-brands:amazon', platform: 'Amazon' },
    { title: 'Let\'s Work Together', sub: `Pull up a chair · ${meta.authorEmail}`, url: `mailto:${meta.authorEmail}`, icon: 'fa7-solid:envelope', platform: 'Email' },
  ]
  const ventures = [
    { title: 'Niyama.Academy', sub: 'An online yoga studio for all levels, with Nicole.', url: 'https://niyama.academy', icon: 'fa7-solid:spa' },
    { title: 'BOLSTair', sub: 'A travel-friendly inflatable yoga and fitness bolster.', url: 'https://bolstair.com', icon: 'fa7-solid:suitcase-rolling' },
  ]

section.linktree
  img.linktree-avatar&attributes(helpers.imageAttrs(meta.avatarImage, { sizes: '112px', loading: false, defaultWidth: 320, alt: meta.authorName }))
  h1= meta.authorName
  p.linktree-tagline
    = meta.tagline
    br
    = meta.taglineDetail

  ul.linktree-social
    each social in socials
      li
        a(href=social.url title=social.name aria-label=social.name)
          != helpers.icon(social.icon)

  p.linktree-total(title=`${followers.total.toLocaleString('en-US')} across YouTube, Instagram, and Substack`)
    strong= followers.totalLabel
    |  followers

  ul.linktree-links
    each link in links
      li
        a(href=link.url class=link.primary ? 'is-primary' : null aria-label=`${link.title}: ${link.sub} (${link.platform})`)
          span.linktree-icon!= helpers.icon(link.icon)
          span.linktree-text
            span.linktree-title= link.platform === 'Email' ? link.title : `${link.title} on ${link.platform}`
            span.linktree-sub(title=link.sub)= link.sub
          span.linktree-arrow(aria-hidden="true") →

  h2.linktree-heading What I'm building
  ul.linktree-links.linktree-ventures
    each link in ventures
      li
        a(href=link.url aria-label=`${link.title}: ${link.sub}`)
          span.linktree-icon!= helpers.icon(link.icon)
          span.linktree-text
            span.linktree-title= link.title
            span.linktree-sub(title=link.sub)= link.sub
          span.linktree-arrow(aria-hidden="true") →

  p.linktree-more
    a(href="/now/") What I'm doing #[span.linktree-now /now]
