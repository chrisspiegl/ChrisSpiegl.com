.post
  h1
    a(href=((externalLink) ? externalLink : url), title="Permalink")!= title
  p
    time(datetime=global.dateHtml(page.date), pubdate="pubdate")= global.dateReadable(page.date)
    = ' '
    a(class="permalink", title="Permalink" href=page.url) ∞

  div.content!= content

  div.content Share your feedback about this article with me via #[a(href=`mailto:chris@chrisspiegl.com?subject=${encodeURIComponent(`Post Feedback about ${title}`)}`) Email].

  div.linkBack: p: a(href="/archive") Archive of all Articles
