{#- A picture with a caption. imgSrc is a path under /assets/images, served
    responsive through utils/images.js. The caption may use Markdown. -#}
{%- macro figure(imgSrc, caption, alt) -%}
<figure>
{% image imgSrc, alt or "", "content" %}
<figcaption>{{ caption | markdown | safe }}</figcaption>
</figure>
{%- endmacro -%}
