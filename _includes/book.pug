extends layout
block content
  .container.post
    - const titleCombined = `${title} by ${author}`
    - const linkAmazon = `https://assoc-redirect.amazon.com/g/r/https://amazon.com/dp/${isbn}?tag=cstrax-20`
    .book-list
      div.cover-photo
        - const coverSrc = cover ? `/assets/images/book/${cover}.png` : null
        if coverSrc && helpers.hasImage(coverSrc)
          img(src=helpers.imageUrl(coverSrc, 640) alt=titleCombined title=titleCombined)
        else
          span.image-missing(aria-hidden='true')
      div.details
        h2= titleCombined
        p Last Updated:
          = ' '
          time(datetime=global.dateHtml(pageUpdated), pubdate="pubdate")= global.dateReadable(pageUpdated)
          = ' '
          a(class="permalink", title="Permalink" href=page.url) ∞

        ul
          li Author: #[=author]
          li Would Recommend: #[=rating]/10
          if dateReleased
            li Date Released: #[=global.dateReadable(dateReleased)]
          if dateRead
            li Date Read: #[=global.dateReadable(dateRead)]
          if isbn
            li ISBN: #[a(href=linkAmazon)= isbn]
          if linkAmazon
            li Reviews & Details on #[a(href=linkAmazon) Amazon]

    div.excerpt: p= excerpt

    if content
      h3 My Notes
      div.content!= content

    div.linkBack: p: a(href="/books") List of all Books
